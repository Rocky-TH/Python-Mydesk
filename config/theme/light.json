{
    "name": "浅色主题",
    "description": "参考VSCode Light+配色方案",
    "is_dark": false,
    
    "colors": {
        "primary": "#3a8fd4",
        "primary-hover": "#4a9fe4",
        "primary-pressed": "#2a7fc4",
        
        "success": "#098658",
        "success-hover": "#0aa068",
        "success-pressed": "#076c48",
        "warning": "#ca8a04",
        "warning-hover": "#e0a008",
        "danger": "#cd3131",
        "danger-hover": "#e03d3d",
        "info": "#007acc",
        "info-hover": "#1a8ad4",
        
        "bg-main": "#f5f5f5",
        "bg-secondary": "#efefef",
        "bg-tertiary": "#e6e6e6",
        "bg-input": "#f9f9f9",
        "bg-input-focus": "#dbeafe",

        "border": "#d4d4d4",
        "border-light": "#dcdcdc",
        "border-focus": "#007acc",

        "text": "#1e1e1e",
        "text-secondary": "#4a4a4a",
        "text-hint": "#767676",
        "text-success": "#098658",
        "text-warning": "#ca8a04",
        "text-danger": "#cd3131",
        "text-info": "#007acc",
        
        "selection": "#add6ff",
        "selection-text": "#333333"
    },
    
    "fonts": {
        "size-sm": "11px",
        "size-md": "12px",
        "size-lg": "13px",
        "size-xl": "14px",
        "size-xxl": "16px",
        "weight-normal": "500",
        "weight-bold": "bold"
    },
    
    "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "xl": "12px"
    },
    
    "components": {
        "button": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px 16px",
            "radius": "@radius.md",
            "font-size": "@fonts.size-md",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-secondary": {
            "bg": "@bg-tertiary",
            "color": "@text",
            "border": "1px solid @border",
            "padding": "8px 16px",
            "radius": "@radius.md",
            "font-size": "@fonts.size-md",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@bg-input-focus",
            "hover-border": "@border-focus",
            "pressed-bg": "@bg-secondary"
        },
        
        "button-function": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-success": {
            "bg": "@success",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@success-hover",
            "pressed-bg": "@success-pressed"
        },
        
        "button-danger": {
            "bg": "@danger",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@danger-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-calc-number": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border-light",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@bg-input-focus",
            "pressed-bg": "@bg-tertiary"
        },
        
        "button-calc-function": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-calc-equals": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-calc-clear": {
            "bg": "@danger",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@danger-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "input": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border",
            "padding": "6px 10px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-md",
            "focus-bg": "@bg-input-focus",
            "focus-border": "@border-focus"
        },
        
        "combo-box": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border",
            "padding": "6px 10px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-md",
            "popup-bg": "@bg-secondary",
            "popup-color": "@text",
            "popup-selection-bg": "@selection",
            "popup-selection-color": "@selection-text"
        },
        
        "text-edit": {
            "bg": "@bg-secondary",
            "color": "@text",
            "border": "1px solid @border",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-family": "Consolas",
            "font-size": "@fonts.size-md"
        },
        
        "label": {
            "color": "@text",
            "font-size": "@fonts.size-md"
        },
        
        "label-secondary": {
            "color": "@text-secondary",
            "font-size": "@fonts.size-sm"
        },
        
        "menu": {
            "bg": "@bg-secondary",
            "color": "@text",
            "border": "1px solid @border",
            "radius": "@radius.md",
            "padding": "4px",
            "item-padding": "6px 24px",
            "item-selected-bg": "@primary",
            "item-selected-color": "#ffffff",
            "separator-bg": "@border-light",
            "separator-height": "1px"
        },
        
        "tab": {
            "bg": "@bg-tertiary",
            "color": "@text-secondary",
            "selected-bg": "@primary",
            "selected-color": "#ffffff",
            "hover-bg": "@bg-input",
            "hover-color": "@text",
            "border": "@border",
            "padding": "10px 24px",
            "font-size": "@fonts.size-md",
            "radius": "@radius.md"
        },
        
        "list": {
            "bg": "@bg-secondary",
            "color": "@text",
            "border": "1px solid @border",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-md",
            "item-selected-bg": "@selection",
            "item-selected-color": "@selection-text",
            "item-hover-bg": "@bg-tertiary"
        },
        
        "group-box": {
            "color": "@text",
            "border": "1px solid @border",
            "radius": "@radius.lg",
            "bg": "@bg-secondary",
            "font-size": "@fonts.size-md",
            "font-weight": "@fonts.weight-bold"
        },
        
        "dialog": {
            "bg": "@bg-secondary",
            "color": "@text"
        },
        
        "scroll-bar": {
            "bg": "@bg-tertiary",
            "handle-bg": "@border",
            "handle-hover-bg": "@primary",
            "handle-radius": "@radius.sm"
        }
    }
}