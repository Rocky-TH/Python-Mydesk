{
    "name": "深色主题",
    "description": "参考VSCode Dark+配色方案",
    "is_dark": true,
    
    "colors": {
        "primary": "#3a8fd4",
        "primary-hover": "#4a9fe4",
        "primary-pressed": "#2a7fc4",
        
        "success": "#4ec9b0",
        "success-hover": "#5dd4bb",
        "success-pressed": "#3db89f",
        "warning": "#dcdcaa",
        "warning-hover": "#e8e5b7",
        "danger": "#f44747",
        "danger-hover": "#f65a5a",
        "info": "#569cd6",
        "info-hover": "#6ba8db",
        
        "bg-main": "#1e1e1e",
        "bg-secondary": "#252526",
        "bg-tertiary": "#2d2d30",
        "bg-input": "#454545",
        "bg-input-focus": "#3a5878",

        "border": "#3c3c3c",
        "border-light": "#4a4a4a",
        "border-focus": "#007acc",

        "text": "#e0e0e0",
        "text-secondary": "#b0b0b0",
        "text-hint": "#858585",
        "text-success": "#4ec9b0",
        "text-warning": "#dcdcaa",
        "text-danger": "#f44747",
        "text-info": "#569cd6",
        
        "selection": "#264f78",
        "selection-text": "#ffffff"
    },
    
    "fonts": {
        "size-sm": "11px",
        "size-md": "12px",
        "size-lg": "13px",
        "size-xl": "14px",
        "size-xxl": "16px",
        "weight-normal": "500",
        "weight-bold": "bold"
    },
    
    "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "xl": "12px"
    },
    
    "components": {
        "button": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px 16px",
            "radius": "@radius.md",
            "font-size": "@fonts.size-md",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-secondary": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border-light",
            "padding": "8px 16px",
            "radius": "@radius.md",
            "font-size": "@fonts.size-md",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@bg-input-focus",
            "hover-border": "@border-focus",
            "pressed-bg": "@bg-tertiary"
        },
        
        "button-function": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-success": {
            "bg": "@success",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@success-hover",
            "pressed-bg": "@success-pressed"
        },
        
        "button-danger": {
            "bg": "@danger",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@danger-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-calc-number": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border-light",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@bg-input-focus",
            "pressed-bg": "@bg-tertiary"
        },
        
        "button-calc-function": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-calc-equals": {
            "bg": "@primary",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@primary-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "button-calc-clear": {
            "bg": "@danger",
            "color": "#ffffff",
            "border": "none",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-lg",
            "font-weight": "@fonts.weight-bold",
            "hover-bg": "@danger-hover",
            "pressed-bg": "@primary-pressed"
        },
        
        "input": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border-light",
            "padding": "6px 10px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-md",
            "focus-bg": "@bg-input-focus",
            "focus-border": "@border-focus"
        },
        
        "combo-box": {
            "bg": "@bg-input",
            "color": "@text",
            "border": "1px solid @border-light",
            "padding": "6px 10px",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-md",
            "popup-bg": "@bg-tertiary",
            "popup-color": "@text",
            "popup-selection-bg": "@selection",
            "popup-selection-color": "@selection-text"
        },
        
        "text-edit": {
            "bg": "@bg-main",
            "color": "@text",
            "border": "1px solid @border",
            "padding": "8px",
            "radius": "@radius.sm",
            "font-family": "Consolas",
            "font-size": "@fonts.size-md"
        },
        
        "label": {
            "color": "@text",
            "font-size": "@fonts.size-md"
        },
        
        "label-secondary": {
            "color": "@text-secondary",
            "font-size": "@fonts.size-sm"
        },
        
        "menu": {
            "bg": "@bg-tertiary",
            "color": "@text",
            "border": "1px solid @border-light",
            "radius": "@radius.md",
            "padding": "4px",
            "item-padding": "6px 24px",
            "item-selected-bg": "@primary",
            "item-selected-color": "#ffffff",
            "separator-bg": "@border-light",
            "separator-height": "1px"
        },
        
        "tab": {
            "bg": "@bg-tertiary",
            "color": "@text-secondary",
            "selected-bg": "@primary",
            "selected-color": "#ffffff",
            "hover-bg": "@bg-input",
            "hover-color": "@text",
            "border": "@border",
            "padding": "10px 24px",
            "font-size": "@fonts.size-md",
            "radius": "@radius.md"
        },
        
        "list": {
            "bg": "@bg-main",
            "color": "@text",
            "border": "1px solid @border",
            "radius": "@radius.sm",
            "font-size": "@fonts.size-md",
            "item-selected-bg": "@selection",
            "item-selected-color": "@selection-text",
            "item-hover-bg": "@bg-tertiary"
        },
        
        "group-box": {
            "color": "@text",
            "border": "1px solid @border-light",
            "radius": "@radius.lg",
            "bg": "@bg-secondary",
            "font-size": "@fonts.size-md",
            "font-weight": "@fonts.weight-bold"
        },
        
        "dialog": {
            "bg": "@bg-secondary",
            "color": "@text"
        },
        
        "scroll-bar": {
            "bg": "@bg-tertiary",
            "handle-bg": "@border-light",
            "handle-hover-bg": "@primary",
            "handle-radius": "@radius.sm"
        }
    }
}